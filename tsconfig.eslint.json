{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "customConditions": ["development"],
    "jsx": "preserve",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/test/fixtures/**"]
}
