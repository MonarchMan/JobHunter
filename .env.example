# Copy to .env and fill only the providers you explicitly enable.
DATA_ROOT=./var
# Optional mailbox config path; relative paths resolve from the workspace root.
# MAILBOX_CONFIG_PATH=./var/mail/mailboxes.json
# Optional encrypted mailbox credential file and generated-key file paths. Keep them out of normal backups.
# MAILBOX_CREDENTIAL_PATH=./var/mail/credentials.enc.json
# MAILBOX_CREDENTIAL_KEY_PATH=./var/mail/credentials.key
# Optional 32-byte Base64 or 64-character hex master key. When omitted, the key file is generated.
# For cross-machine migration, transfer the encrypted file and provide the same key through a separate secure channel.
# MAILBOX_CREDENTIAL_KEY=
# OAuth 回调基址；必须与 Google Cloud 和 Microsoft Entra 中登记的回调地址一致。
WEB_BASE_URL=http://127.0.0.1:3210
# Gmail OAuth：回调地址为 <WEB_BASE_URL>/api/mailboxes/oauth/gmail/callback
GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# Microsoft 365 / Outlook OAuth：回调地址为 <WEB_BASE_URL>/api/mailboxes/oauth/microsoft-graph/callback
MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# 邮件候选正文发送给配置模型前需显式开启；默认 off，仅规则筛选并保留待确认引用。
# MAIL_MODEL_MODE=configured
LOG_LEVEL=info
# Worker polling (100-60000 ms), network concurrency (1-32), and optional per-task limits (1-32).
WORKER_POLL_INTERVAL_MS=1000
MAX_CONCURRENT_NETWORK_TASKS=4
TASK_TYPE_CONCURRENCY='{"source.sync":3,"source.job-detail":4,"source.health-check":2}'
# 模型价格货币：USD 或 CNY；每百万 Token 单价必须使用同一货币。
# MODEL_COST_CURRENCY=USD
# MODEL_INPUT_COST_PER_MILLION_USD=0.15
# MODEL_OUTPUT_COST_PER_MILLION_USD=0.5
# 页面成本统一换算时使用的 USD/CNY 汇率；默认 7.2，可按实际结算汇率覆盖。
# MODEL_USD_TO_CNY_RATE=7.2
# Shared fallback for platform request intervals in ms (0-60000).
PLATFORM_REQUEST_INTERVAL_MS=0
# Optional per-platform overrides; omitted values use the shared fallback.
# PLATFORM_REQUEST_INTERVAL_MS_BOSS=0
# PLATFORM_REQUEST_INTERVAL_MS_ZHILIAN=0
# PLATFORM_REQUEST_INTERVAL_MS_51JOB=0
# PLATFORM_REQUEST_INTERVAL_MS_LIEPIN=1000
# Optional override. Standard Chrome/Edge paths are auto-detected on macOS and Windows.
# BROWSER_EXECUTABLE=/absolute/path/to/chrome
# Optional. Defaults to https://api.openai.com/v1; an "anthropic" host label or path segment selects Anthropic.
BASE_URL=
MODEL=
API_KEY=
# Optional override in USD per one million tokens. Otherwise the normalized model ID uses the built-in catalog.
MODEL_INPUT_COST_PER_MILLION_USD=
MODEL_OUTPUT_COST_PER_MILLION_USD=
