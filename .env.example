# Copy to .env and fill only the providers you explicitly enable.
JOBHUNTER_DATA_ROOT=./var
# Optional mailbox config path; relative paths resolve from the workspace root.
# JOBHUNTER_MAILBOX_CONFIG_PATH=./var/mail/mailboxes.json
# Optional encrypted mailbox credential file and generated-key file paths. Keep them out of normal backups.
# JOBHUNTER_MAILBOX_CREDENTIAL_PATH=./var/mail/credentials.enc.json
# JOBHUNTER_MAILBOX_CREDENTIAL_KEY_PATH=./var/mail/credentials.key
# Optional 32-byte Base64 or 64-character hex master key. When omitted, the key file is generated.
# For cross-machine migration, transfer the encrypted file and provide the same key through a separate secure channel.
# JOBHUNTER_MAILBOX_CREDENTIAL_KEY=
# OAuth 回调基址；必须与 Google Cloud 和 Microsoft Entra 中登记的回调地址一致。
JOBHUNTER_WEB_BASE_URL=http://127.0.0.1:3210
# Gmail OAuth：回调地址为 <JOBHUNTER_WEB_BASE_URL>/api/mailboxes/oauth/gmail/callback
JOBHUNTER_GMAIL_CLIENT_ID=
# JOBHUNTER_GMAIL_CLIENT_SECRET=
# Microsoft 365 / Outlook OAuth：回调地址为 <JOBHUNTER_WEB_BASE_URL>/api/mailboxes/oauth/microsoft-graph/callback
JOBHUNTER_MICROSOFT_CLIENT_ID=
# JOBHUNTER_MICROSOFT_CLIENT_SECRET=
JOBHUNTER_MICROSOFT_TENANT=common
# 邮件候选正文发送给配置模型前需显式开启；默认 off，仅规则筛选并保留待确认引用。
# JOBHUNTER_MAIL_MODEL_MODE=configured
JOBHUNTER_LOG_LEVEL=info
# Worker polling (100-60000 ms), network concurrency (1-32), and optional per-task limits (1-32).
JOBHUNTER_WORKER_POLL_INTERVAL_MS=1000
JOBHUNTER_MAX_CONCURRENT_NETWORK_TASKS=4
JOBHUNTER_TASK_TYPE_CONCURRENCY='{"source.sync":3,"source.job-detail":4,"source.health-check":2}'
# Shared fallback for platform request intervals in ms (0-60000).
JOBHUNTER_PLATFORM_REQUEST_INTERVAL_MS=0
# Optional per-platform overrides; omitted values use the shared fallback.
# JOBHUNTER_PLATFORM_REQUEST_INTERVAL_MS_BOSS=0
# JOBHUNTER_PLATFORM_REQUEST_INTERVAL_MS_ZHILIAN=0
# JOBHUNTER_PLATFORM_REQUEST_INTERVAL_MS_51JOB=0
# JOBHUNTER_PLATFORM_REQUEST_INTERVAL_MS_LIEPIN=1000
# Optional override. Standard Chrome/Edge paths are auto-detected on macOS and Windows.
# JOBHUNTER_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# Optional. Defaults to https://api.openai.com/v1; an "anthropic" host label or path segment selects Anthropic.
BASE_URL=
MODEL=
API_KEY=
