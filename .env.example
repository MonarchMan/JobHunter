# Copy to .env and fill only the providers you explicitly enable.
JOBHUNTER_DATA_ROOT=./var
JOBHUNTER_LOG_LEVEL=info
# Optional override. Standard Chrome/Edge paths are auto-detected on macOS and Windows.
# JOBHUNTER_BROWSER_EXECUTABLE=/absolute/path/to/chrome
JOBHUNTER_MODEL_PROVIDER=
JOBHUNTER_MODEL_BASE_URL=
JOBHUNTER_MODEL_NAME=
JOBHUNTER_MODEL_API_KEY=

# Personal OpenAI-compatible aliases are also accepted: BASE_URL, MODEL, API_KEY.
