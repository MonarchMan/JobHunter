{
  "name": "@jobhunter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --import tsx src/server/main.ts",
    "dev:typecheck": "pnpm --workspace-root typecheck:watch",
    "build": "next build",
    "test:browser": "playwright test",
    "start": "tsx src/server/main.ts --production",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@jobhunter/common": "workspace:*",
    "@jobhunter/recruitment": "workspace:*",
    "@jobhunter/matching": "workspace:*",
    "@jobhunter/user": "workspace:*",
    "@radix-ui/react-select": "^2.3.7",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.21.0"
  }
}
