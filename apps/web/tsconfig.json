{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "next.config.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/common"
    },
    {
      "path": "../../packages/matching"
    },
    {
      "path": "../../packages/user"
    },
    {
      "path": "../../packages/recruitment"
    }
  ]
}
