{
  "name": "@jobhunter/sources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog-data": {
      "development": "./src/catalog/sources.ts",
      "types": "./dist/catalog/sources.d.ts",
      "import": "./dist/catalog/sources.js"
    },
    "./registry": {
      "development": "./src/catalog/registry.ts",
      "types": "./dist/catalog/registry.d.ts",
      "import": "./dist/catalog/registry.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@jobhunter/domain": "workspace:*",
    "@jobhunter/source-core": "workspace:*",
    "zod": "^4.1.13"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
